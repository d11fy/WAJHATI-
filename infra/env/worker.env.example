DAR_ENV=production
APP_ORIGIN=https://market.example.com
PUBLIC_SIGNUP_ENABLED=false
MEDIA_WORKER_DATABASE_URL=postgresql://dar_worker:REPLACE_ME@db:5432/dar_production
S3_BUCKET=dar-production-media-REPLACE_ME
S3_REGION=REPLACE_ME
S3_ENDPOINT=https://storage.example.com
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=REPLACE_ME_WORKER_ONLY
AWS_SECRET_ACCESS_KEY=REPLACE_ME_WORKER_ONLY
# The worker holds no mail secrets. Notifications are sent by the separate mailer process (mailer.env).
# DAR_ALERT_WEBHOOK=https://private-alert-collector.example.com/dar-market
# DAR_ALERT_KEY=REPLACE_ME
