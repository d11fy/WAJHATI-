DAR_ENV=production
APP_ORIGIN=https://market.example.com
PUBLIC_SIGNUP_ENABLED=false
# Production refuses to start until the Terms and Privacy Policy have been reviewed and approved by the owner/counsel.
# Leave false until docs/legal/LEGAL_OWNER_REVIEW.md is fully resolved. Staging may leave it false.
LEGAL_APPROVED=false
TRUSTED_CLIENT_IP_HEADER=x-real-ip
DATABASE_URL=postgresql://dar_runtime:REPLACE_ME@db:5432/dar_production
IDENTITY_DATABASE_URL=postgresql://dar_identity:REPLACE_ME@db:5432/dar_production
S3_BUCKET=dar-production-media-REPLACE_ME
S3_REGION=REPLACE_ME
S3_ENDPOINT=https://storage.example.com
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
S3_READY_KEY=ops/readiness
# Mail: configure the owner-managed SMTP in the platform panel (needs this key), or use Resend, or both. Resend is optional.
# The key must be 64 hex characters, unique to this environment, and must never be replaced without re-entering the SMTP password.
SMTP_CONFIG_KEY=REPLACE_ME
# Optional Resend (all three together). Not required when the owner-managed SMTP is used.
# MAIL_PROVIDER=resend
# RESEND_API_KEY=REPLACE_ME
# MAIL_FROM=mail@market.example.com
# Staging only: the only recipients this environment may email (addresses or @domain, comma separated). Forbidden in production.
# MAIL_ALLOWED_RECIPIENTS=qa@example.com,@example.org
PLATFORM_MFA_KEY=REPLACE_ME_64_HEX
PAYMENT_PROOF_ACTIVE_KEY=v1
PAYMENT_PROOF_KEYRING='{"v1":"REPLACE_ME_64_HEX"}'
# Set PAYMENT_PROOF_KEY for pre-Phase 6B evidence if such records are imported.
OPS_METRICS_TOKEN=REPLACE_ME_64_HEX
# DAR_ALERT_WEBHOOK=https://private-alert-collector.example.com/dar-market
# DAR_ALERT_KEY=REPLACE_ME
