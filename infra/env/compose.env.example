DAR_HOST=market.example.com
DAR_ORIGIN=https://market.example.com
EDGE_BIND=0.0.0.0
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443
DAR_APP_ENV=.ops/production/app.env
DAR_WORKER_ENV=.ops/production/worker.env
DAR_DB_ENV=.ops/production/db.env
DAR_OPERATOR_ENV=.ops/production/operator.env
DAR_BACKUP_ENV=.ops/production/backup.env
DAR_IMAGE=dar-market:REPLACE_ME_RELEASE
DAR_PDF_IMAGE=dar-market-pdf:REPLACE_ME_RELEASE
DAR_OPS_IMAGE=dar-market-ops:REPLACE_ME_RELEASE
DAR_PROXY_IMAGE=dar-market-proxy:REPLACE_ME_RELEASE
