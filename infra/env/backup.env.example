DAR_ENV=production
PUBLIC_SIGNUP_ENABLED=false
BACKUP_DATABASE_URL=postgresql://dar_backup:REPLACE_ME@db:5432/dar_production
BACKUP_BUCKET=dar-production-backup-REPLACE_ME
BACKUP_DIR=/backups
BACKUP_KEY_ID=v1
BACKUP_KEY=REPLACE_ME_64_HEX
BACKUP_S3_ENDPOINT=https://backup-storage.example.com
BACKUP_S3_FORCE_PATH_STYLE=true
BACKUP_REGION=REPLACE_ME
BACKUP_AWS_ACCESS_KEY_ID=REPLACE_ME_BACKUP_ONLY
BACKUP_AWS_SECRET_ACCESS_KEY=REPLACE_ME_BACKUP_ONLY
# DAR_ALERT_WEBHOOK=https://private-alert-collector.example.com/dar-market
# DAR_ALERT_KEY=REPLACE_ME
