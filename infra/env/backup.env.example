DAR_ENV=production
PUBLIC_SIGNUP_ENABLED=false
BACKUP_DATABASE_URL=postgresql://dar_backup:REPLACE_ME@db:5432/dar_production
BACKUP_BUCKET=dar-production-backup-REPLACE_ME
BACKUP_DIR=/backups
BACKUP_KEY_ID=v1
BACKUP_KEY=REPLACE_ME_64_HEX
BACKUP_S3_ENDPOINT=https://backup-storage.example.com
BACKUP_S3_FORCE_PATH_STYLE=true
BACKUP_REGION=REPLACE_ME
BACKUP_AWS_ACCESS_KEY_ID=REPLACE_ME_BACKUP_ONLY
BACKUP_AWS_SECRET_ACCESS_KEY=REPLACE_ME_BACKUP_ONLY
# DAR_ALERT_WEBHOOK=https://private-alert-collector.example.com/dar-market
# DAR_ALERT_KEY=REPLACE_ME
# Media backup (optional but recommended): reads the live media bucket with its own READ-ONLY credential, never the app's.
# BACKUP_SOURCE_BUCKET=dar-production-media-REPLACE_ME
# BACKUP_SOURCE_S3_ENDPOINT=https://storage.example.com
# BACKUP_SOURCE_S3_FORCE_PATH_STYLE=true
# BACKUP_SOURCE_AWS_ACCESS_KEY_ID=REPLACE_ME
# BACKUP_SOURCE_AWS_SECRET_ACCESS_KEY=REPLACE_ME
# Freshness: the check alerts when the newest manifest is older than this many hours (default 26).
# BACKUP_MAX_AGE_HOURS=26
# Optional external dead-man monitor (HTTPS). Pinged only after a fully successful backup run; the monitor alerts when pings stop.
# DAR_HEARTBEAT_URL=https://monitor.example.com/ping/REPLACE_ME
