DAR_ENV=production
APP_ORIGIN=https://market.example.com
PUBLIC_SIGNUP_ENABLED=false
# The mail delivery login (role dar_mailer, group storefront_mailer). It can run the notification queue and read the
# SMTP secret, and has no table access. Never reuse another service's database login here.
MAIL_WORKER_DATABASE_URL=postgresql://dar_mailer:REPLACE_ME@db:5432/dar_production
# Same value as the app's SMTP_CONFIG_KEY (the app and this process both open the stored SMTP password). 64 hex characters.
SMTP_CONFIG_KEY=REPLACE_ME
# Optional Resend (all three together). Not required when the owner-managed SMTP is used.
# MAIL_PROVIDER=resend
# RESEND_API_KEY=REPLACE_ME
# MAIL_FROM=mail@market.example.com
# Staging only: the only recipients this environment may email. Forbidden in production.
# MAIL_ALLOWED_RECIPIENTS=qa@example.com,@example.org
# DAR_ALERT_WEBHOOK=https://private-alert-collector.example.com/dar-market
# DAR_ALERT_KEY=REPLACE_ME
