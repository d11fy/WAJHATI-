[Unit]
Description=Dar Market encrypted PostgreSQL backup
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/srv/dar-market
ExecStart=/usr/bin/docker compose --project-name dar-production --env-file .ops/production/compose.env --profile backup run --rm backup
TimeoutStartSec=45min
