{
  "name": "dar-market",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname localhost",
    "build": "next build --webpack",
    "start": "next start --hostname localhost",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test --test-concurrency=1 tests/unit/*.test.ts",
    "test:db": "node --conditions=react-server --import tsx --test --test-concurrency=2 tests/integration/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:e2e": "node --test --test-concurrency=2 tests/e2e/*.test.mjs",
    "media:cleanup": "node --conditions=react-server --import tsx scripts/catalog-cleanup.ts",
    "orders:cleanup": "node --conditions=react-server --import tsx scripts/catalog-cleanup.ts --orders",
    "billing:expire": "node --conditions=react-server --import tsx scripts/catalog-cleanup.ts --billing",
    "ops:notifications": "node --conditions=react-server --import tsx scripts/catalog-cleanup.ts --notifications",
    "ops:maintenance": "node --conditions=react-server --import tsx scripts/catalog-cleanup.ts --maintenance",
    "ops:schedule": "node scripts/ops/scheduler.mjs",
    "ops:backup": "node scripts/ops/backup.mjs backup",
    "ops:restore": "node scripts/ops/backup.mjs restore",
    "ops:staging-env": "node scripts/ops/staging-env.mjs",
    "billing:operator": "node --conditions=react-server --import tsx scripts/billing-operator.ts",
    "platform:operator": "node --conditions=react-server --import tsx scripts/platform-operator.ts",
    "local:dev": "node scripts/local-env.mjs dev",
    "local:staging": "node scripts/local-env.mjs staging",
    "local:staging-smoke": "node scripts/local-env.mjs staging-smoke",
    "local:check": "node scripts/local-env.mjs check",
    "local:verify": "node scripts/local-env.mjs verify",
    "local:cleanup-check": "node scripts/local-env.mjs cleanup-check"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@fontsource-variable/cairo": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/noto-sans-arabic": "^5.2.0",
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/poppins": "5.3.0",
    "@napi-rs/canvas": "1.0.13",
    "@next/env": "16.4.5",
    "drizzle-orm": "^0.45.4",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^0.577.0",
    "next": "16.4.5",
    "nodemailer": "^10.5.0",
    "pdfjs-dist": "6.5.438",
    "pg": "^8.20.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.18.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.5",
    "playwright-core": "^1.65.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.0"
  }
}
