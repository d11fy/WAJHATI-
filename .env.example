# For manually managed services. npm run local:dev injects the isolated 55432/4569 configuration.
# Runtime login. Use a role that inherits storefront_app and does not own the tables.
DATABASE_URL=postgresql://dar_runtime:REPLACE_ME@localhost:5432/dar_market

# Schema owner used only by Drizzle Kit. Keep this out of the app process in production.
MIGRATION_DATABASE_URL=postgresql://dar_owner:REPLACE_ME@localhost:5432/dar_market

# Optional. Set only when your proxy strips inbound copies and supplies one client IP.
# TRUSTED_CLIENT_IP_HEADER=x-real-ip

# Public origin used for image mutation CSRF checks and product metadata URLs.
APP_ORIGIN=http://localhost:3000

# Private S3-compatible bucket. Leave S3_ENDPOINT unset for AWS S3.
S3_BUCKET=dar-market-local
S3_REGION=us-east-1
# S3_ENDPOINT=http://127.0.0.1:4569
# S3_FORCE_PATH_STYLE=true
# AWS_ACCESS_KEY_ID=REPLACE_ME
# AWS_SECRET_ACCESS_KEY=REPLACE_ME

# Optional cleanup process. Never put schema-owner credentials here.
# MEDIA_WORKER_DATABASE_URL=postgresql://dar_media:REPLACE_ME@localhost:5432/dar_market

# Local-only switch. Public registration remains closed without verification and password recovery.
# DAR_LOCAL_SIGNUP=true

# Separate identity login. Grant storefront_identity only; never share the runtime or owner login.
# IDENTITY_DATABASE_URL=postgresql://dar_identity:REPLACE_ME@localhost:5432/dar_market
# Independent 32-byte hex keys. Back up securely outside the database and application repository.
# PLATFORM_MFA_KEY=
# PAYMENT_PROOF_KEY=
# SMTP_CONFIG_KEY=
# PAYMENT_PROOF_ACTIVE_KEY=v1
# PAYMENT_PROOF_KEYRING='{"v1":"REPLACE_ME_64_HEX"}'

# Public signup is email-first. It requires HTTPS APP_ORIGIN, the provider and a trusted IP header.
# PUBLIC_SIGNUP_ENABLED=false
# MAIL_PROVIDER=resend
# MAIL_FROM=
# RESEND_API_KEY=
# Local file sink and PDF renderer are enabled by the local launcher on loopback only.

# Production Compose uses a private Unix socket. A separate HTTPS renderer remains optional for other environments.
# PAYMENT_RENDERER_SOCKET=/run/dar-pdf/worker.sock
# PAYMENT_RENDERER_URL=
# PAYMENT_RENDERER_KEY=

# Optional HTTPS alert destination. Structured event codes only.
# DAR_ALERT_WEBHOOK=
# DAR_ALERT_KEY=

# Production configuration is split by process under infra/env/*.env.example.
# S3_READY_KEY=ops/readiness
# OPS_METRICS_TOKEN=

# WAJHATI AI writing assistant. Server-only; never commit a real key. Without a key the assistant is shown as not set up.
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_THINKING=false
# AI_ASSISTANT_ENABLED=true
# Local and test only (DAR_ENV=development or test): deterministic provider, no network.
# AI_PROVIDER=mock
